# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.cloud.example

# Google Cloud credentials (NEVER commit these!)
google-credentials.json
*-credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated content
/src/data/generated/
/public/projects/
/public/elibrary/
/public/homepage_hero/
/public/team/
/public/services/
/public/hero/

# media files (synced to R2, not tracked in Git)
# Projects
content/projects/*/images/
content/projects/*/pdfs/

# Homepage Hero
content/homepage_hero/images/

# Team
content/team/images/

# Services
content/services/*/images/
content/services/*/diagrams/

# eLibrary
content/elibrary/*/files/

# Keep CSV files (version controlled)
!content/**/*.csv

# development files
.claude/
*.log
.vscode/settings.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
*.swp
*.swo
*~
