{
  "name": "ns-engineering-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:content": "tsx scripts/build-content.ts",
    "build:content:local": "cross-env CONTENT_SOURCE_MODE=csv tsx scripts/build-content.ts",
    "build:content:cloud": "dotenv -e .env.cloud -- cross-env CONTENT_SOURCE_MODE=sheets tsx scripts/build-content.ts",
    "generate:redirects": "tsx scripts/generate-redirects.ts",
    "prebuild": "npm run build:content",
    "dev": "npm run build:content && next dev",
    "dev:local": "npm run build:content:local && cross-env CONTENT_SOURCE_MODE=csv next dev",
    "dev:cloud": "npm run build:content:cloud && dotenv -e .env.cloud -- cross-env CONTENT_SOURCE_MODE=sheets next dev",
    "build:local": "npm run build:content:local && cross-env CONTENT_SOURCE_MODE=csv next build",
    "build:cloud": "npm run build:content:cloud && dotenv -e .env.cloud -- cross-env CONTENT_SOURCE_MODE=sheets next build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "json:server": "npx json-server --watch db.json --port 5002 --host 0.0.0.0",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:run": "vitest run"
  },
  "dependencies": {
  "@aws-sdk/client-s3": "^3.956.0",
  "@types/leaflet": "^1.9.21",
  "clsx": "^2.1.1",
  "embla-carousel-autoplay": "^8.6.0",
  "embla-carousel-react": "^8.6.0",
  "framer-motion": "^12.40.0",
  "google-auth-library": "^10.5.0",
  "google-spreadsheet": "^5.0.2",
  "json-server": "^0.17.4",
  "leaflet": "^1.9.4",
  "lucide-react": "^0.555.0",
  "next": "^16.1.1",
  "react": "^19.2.0",
  "react-dom": "^19.2.0",
  "react-hook-form": "^7.66.1",
  "react-leaflet": "^5.0.0",
  "react-leaflet-cluster": "^4.0.0",
  "tailwind-merge": "^3.6.0",
  "zod": "^4.1.13"
},
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.9.5",
    "cross-env": "^7.0.3",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "fs-extra": "^11.3.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
