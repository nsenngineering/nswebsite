# ========================================
# NS Engineering Website - Environment Configuration
# ========================================
# Copy this file to .env.local and configure for your environment

# ========================================
# CONTENT SOURCE MODE
# ========================================
# Options: 'csv' (local files) | 'sheets' (Google Sheets)
# Default: csv
CONTENT_SOURCE_MODE=csv

# ========================================
# GOOGLE SHEETS CONFIGURATION
# ========================================
# Only needed if CONTENT_SOURCE_MODE=sheets

# Get Sheet ID from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_ID=

# Option A: Use credentials file (recommended for local development)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Option B: Use environment variables (recommended for CI/CD)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# ========================================
# CLOUDFLARE R2 CONFIGURATION (Media CDN)
# ========================================
# Set NEXT_PUBLIC_R2_BASE_URL to enable R2 mode
# Leave empty to use local media files

# Your R2 public bucket URL
# Example: https://pub-abc123.r2.dev
NEXT_PUBLIC_R2_BASE_URL=

# Optional: Custom base path within R2 bucket
# Default: projects
R2_BASE_PATH=projects

# Optional: R2 bucket name (for reference/documentation)
R2_BUCKET_NAME=ns-engineering-projects
