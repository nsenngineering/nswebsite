# ========================================
# NS Engineering Website - Cloud Mode Configuration
# ========================================
# Copy this to .env.cloud when working in cloud mode
# DO NOT commit .env.cloud to git (it's in .gitignore)

# ========================================
# CONTENT SOURCE MODE
# ========================================
CONTENT_SOURCE_MODE=sheets

# ========================================
# GOOGLE SHEETS CONFIGURATION
# ========================================
# Google Sheets ID (from URL: docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
# This should be a SINGLE spreadsheet with multiple tabs
GOOGLE_SHEET_ID=your-sheet-id-here

# Service Account Authentication (Option 1 - Local Dev)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Or use direct credentials (Option 2 - CI/CD):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========================================
# GOOGLE SHEETS TAB NAMES (Optional)
# ========================================
# Customize tab names if you don't use the defaults
# Default tab names (matching your Google Sheet):
#   - Projects
#   - HomepageHeroCarousel
#   - HomepageHeroMilestones
#   - Team
#   - ElibraryDocuments
#   - ElibrarySections
#   - ProjectCategories
#   - ServiceCategories
#   - Services
#
# Only uncomment and modify if you use different tab names:
# GOOGLE_SHEET_TAB_PROJECTS=Projects
# GOOGLE_SHEET_TAB_HERO=HomepageHeroCarousel
# GOOGLE_SHEET_TAB_MILESTONES=HomepageHeroMilestones
# GOOGLE_SHEET_TAB_TEAM=Team
# GOOGLE_SHEET_TAB_ELIBRARY=ElibraryDocuments
# GOOGLE_SHEET_TAB_ELIBRARY_SECTIONS=ElibrarySections
# GOOGLE_SHEET_TAB_CATEGORIES=ProjectCategories
# GOOGLE_SHEET_TAB_SERVICE_CATEGORIES=ServiceCategories
# GOOGLE_SHEET_TAB_SERVICES=Services

# ========================================
# CLOUDFLARE R2 CONFIGURATION (Future Phase)
# ========================================
# DISABLED FOR NOW - We'll configure this after Google Sheets is working
# Your R2 public bucket URL (R2.dev subdomain or custom domain)
# NEXT_PUBLIC_R2_BASE_URL=https://pub-XXXXX.r2.dev

# Base path within bucket
# R2_BASE_PATH=projects

# Bucket name
# R2_BUCKET_NAME=ns-engineering-projects

# ========================================
# CLOUDFLARE R2 UPLOAD CREDENTIALS (Optional - Future Phase)
# ========================================
# Only needed for automated uploads via CI/CD
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
